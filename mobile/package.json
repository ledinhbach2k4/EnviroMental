    "@types/react": "~19.3.0",
    "audit-ci": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "expo-module-scripts": "^3.5.2",
    "prettier": "^3.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "markdown-it": "^14.1.0"
  }
}
