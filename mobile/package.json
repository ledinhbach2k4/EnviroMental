{
  "name": "environmental",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start -c",
    "start:env": "node -r dotenv/config node_modules/.bin/expo start",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.5",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/elements": "^2.0.0",
    "@react-navigation/native": "^7.0.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "lodash": "^4.17.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^5.2.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
