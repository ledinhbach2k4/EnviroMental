# ==========================================
# Mobile .gitignore (Expo / React Native)
# ==========================================

# Environment & Secrets (Crucial)
.env
.env.*
.env*.local
*.local
!.env.example

# Native Credentials, Keystores & Certificates
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.cert

# Dependencies
node_modules/

# Expo & Build Artifacts
.expo/
dist/
web-build/
build/
coverage/
expo-env.d.ts

# Native Prebuild Folders & Caches
android/
ios/
.kotlin/
.gradle/
*.orig.*

# Metro & TypeScript
.metro-health-check*
*.tsbuildinfo

# Package Manager & Debug Logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log

# System & OS Files
.DS_Store
.DS_Store?
._*
ehthumbs.db
Thumbs.db

# IDE & Editor
.vscode/
.idea/

# Example / Template code
app-example/

# ARTEMIS/MCP Testing (local only - not committed)
.artemis/
.mcp/
artemis-*.log
mcp-*.log
artemis-report/
test-results/
*.artemis.json
mcp-config.json
