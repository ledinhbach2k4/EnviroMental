# Mobile Environment Variables
# Copy this file to .env and fill in your values

# Clerk Authentication (Public key only - safe for client)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# API URL (your deployed backend)
EXPO_PUBLIC_API_URL=https://your-api.onrender.com/api

# OpenWeather API (for weather/air quality data)
EXPO_PUBLIC_OPEN_WEATHER_API_KEY=your-openweather-api-key