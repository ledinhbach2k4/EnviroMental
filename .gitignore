# ==========================================
# Root .gitignore (EnviroMental Full-Stack Monorepo)
# ==========================================

# Environment & Secrets (Crucial)
.env
.env.*
.env*.local
*.local
backend/.env
backend/.env.*
mobile/.env
mobile/.env.*
!.env.example
!backend/.env.example
!mobile/.env.example

# Sensitive Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Dependencies
node_modules/
backend/node_modules/
mobile/node_modules/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Build Outputs & Bundles
dist/
build/
web-build/
coverage/
*.tsbuildinfo

# Expo & React Native
.expo/
mobile/.expo/
expo-env.d.ts
.metro-health-check*

# Native Build Directories (Prebuilds generated by Expo)
android/
ios/
mobile/android/
mobile/ios/
.kotlin/
.gradle/

# Database & Drizzle (Local DB files - preserve migrations)
*.sqlite
*.sqlite3
*.db
drizzle/
!backend/src/db/migrations/

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local Testing, Artemis & MCP
.artemis/
.mcp/
artemis-*.log
mcp-*.log
artemis-report/
test-results/
*.artemis.json
mcp-config.json
mobile/mcp-config.json

# Local / Draft Project Files
EnviroMental - Function.txt
CLAUDE.md
GEMINI.md
PROJECT.md
TEST_INFRA.md
TEST_READY.md

# AI Agent Skills
.agents/
.skills/
skills-lock.json

