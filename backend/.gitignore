# ==========================================
# Backend .gitignore (Express / Drizzle / Node.js)
# ==========================================

# Environment & Secrets (Crucial)
.env
.env.*
.env*.local
*.local
!.env.example

# Sensitive Keys & Certificates
*.pem
*.key
*.cert

# Dependencies
node_modules/

# Package Manager Logs & General Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build & Coverage
dist/
build/
coverage/

# Database & Local Drizzle Artifacts (Preserve SQL migrations)
*.sqlite
*.sqlite3
*.db
drizzle/
!src/db/migrations/
src/db/sync_drizzle_migrations.js

# System & OS Files
.DS_Store
.DS_Store?
._*
ehthumbs.db
Thumbs.db

# IDE & Editor
.vscode/
.idea/

# Mobile / Expo files if any accidentally placed here
.expo/
android/
ios/
